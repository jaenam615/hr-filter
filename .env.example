# 복사해서 쓰기:  cp .env.example .env  (`.env`는 .gitignore 처리됨)
# 로딩:  set -a && source .env && set +a   → 그 셸에서 bootRun 실행
# docker-compose는 같은 디렉터리의 .env를 자동으로 읽음.

# ── LLM (배치 서버 필수) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
HRFILTER_LLM_MODEL=claude-opus-4-8

# ── 알림 (channel = slack | teams | email) ────────────
HRFILTER_NOTIFIER_CHANNEL=slack
# 검증용으로 https://webhook.site 에서 임시 URL 발급해 넣으면 알림 도착 확인 가능
HRFILTER_SLACK_WEBHOOK_URL=

# ── 데이터소스 (로컬 docker-compose 기본값) ───────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hrfilter
SPRING_DATASOURCE_USERNAME=hrfilter
SPRING_DATASOURCE_PASSWORD=hrfilter

# ── 오브젝트 스토리지 (로컬 MinIO 기본값) ─────────────
HRFILTER_S3_ENDPOINT=http://localhost:9000
HRFILTER_S3_ACCESS_KEY=minioadmin
HRFILTER_S3_SECRET_KEY=minioadmin
HRFILTER_S3_REGION=us-east-1
HRFILTER_S3_BUCKET=hrfilter-resumes
